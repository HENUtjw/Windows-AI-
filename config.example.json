{
  "_说明": "这是完整配置模板。把你需要改的字段复制到 config.json 即可，未写的字段会自动使用默认值。",

  "deepseek": {
    "api_key": "在这里填你的 DeepSeek API Key（也可以改用环境变量 DEEPSEEK_API_KEY）",
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-flash",
    "thinking": "disabled",
    "temperature": 1.3,
    "max_tokens": 256,
    "timeout_seconds": 25,
    "max_retries": 2,
    "stream": true
  },

  "translate": {
    "target_language": "简体中文",
    "context_sentences": 3,
    "workers": 4,
    "max_backlog": 3,
    "speculate": true,
    "speculate_ms": 500,
    "system_prompt": "留空则使用内置的翻译提示词。填了则完全替换它。"
  },

  "captions": {
    "poll_interval_ms": 120,
    "stable_ms": 1400,
    "clause_min_words": 12,
    "auto_launch": true,
    "log_raw_text": true,
    "log_dir": "logs",
    "reconnect_interval_seconds": 2.0
  },

  "cache": {
    "_说明": "第二层：AI 学到的短句缓存。同一短句的译文获得足够票数后晋升，之后直接复用。",
    "enabled": true,
    "max_words": 6,
    "min_hits": 3,
    "majority": 0.75,
    "min_samples": 5,
    "size": 500
  },

  "phrasebook": {
    "_说明": "第一层：内置高频短语包，命中即用（零延迟零成本）。只收录脱离上下文也唯一正确的短语。",
    "enabled": true,
    "path": "留空使用 data/phrasebook.json；可指向自己的文件扩充（提高命中率最直接的办法）"
  },

  "overlay": {
    "enabled": true,
    "font_family": "Microsoft YaHei UI",
    "font_size": 21,
    "source_font_size": 13,
    "show_source": true,
    "alpha": 0.9,
    "background": "#1C1C1C",
    "border_color": "#3A3A3A",
    "corner_radius": 12,
    "text_color": "#FFFFFF",
    "source_color": "#9AA0A6",
    "icon_color": "#C8C8C8",
    "icon_hover_color": "#FFFFFF",
    "width": 1400,
    "position": "bottom-center",
    "margin_bottom": 90,
    "margin_top": 60,
    "margin_x": 40,
    "click_through": false,
    "show_buttons": true,
    "close_livecaptions": true,
    "max_sentences": 2,
    "padding": 26,
    "line_spacing": 6,
    "group_spacing": 16,
    "placeholder_color": "#6B7280"
  }
}
