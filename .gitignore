# 含 API Key，不要提交
config.json

# comtypes 生成缓存
.comtypes_cache/

# 运行日志
logs/

# uiautomation 库默认会在工作目录写这个文件（已在 tools/uia_bootstrap.py 里关闭）
@AutomationLog.txt

# 浮窗预览产生的截图（可用 tools/preview_overlay.py --all 随时重新生成）
_preview/

# 发布包产物（用 tools/make_release.py 重新生成，不进版本库）
dist/
build/
*.spec

# 临时文件
_commit_msg.txt
# 根目录下的下划线开头脚本是我调试用的临时文件（放在子目录里的不算，
# 比如 src/__init__.py）。加这条是因为我已经两次把它们误提交进去了。
/_*.py

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# IDE
.idea/
.vscode/
